{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sentence-grapher",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "parser-server",
      "runtimeExecutable": "server/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app:app",
        "--app-dir",
        "server",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
